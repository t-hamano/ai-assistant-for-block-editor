{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post-new.php",
	"steps": [
		{
			"step": "login",
			"username": "admin"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "ai-provider-for-anthropic"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"connectors_ai_anthropic_api_key": "preview-placeholder-key"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "{{ARTIFACT_URL:ai-assistant-for-block-editor}}"
			}
		}
	]
}
