{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "645px",
			"wideSize": "1340px"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#111111"
				},
				{
					"slug": "accent-1",
					"name": "Accent 1",
					"color": "#FFEE58"
				},
				{
					"slug": "accent-2",
					"name": "Accent 2",
					"color": "#F6CFF4"
				},
				{
					"slug": "accent-3",
					"name": "Accent 3",
					"color": "#503AA8"
				},
				{
					"slug": "accent-4",
					"name": "Accent 4",
					"color": "#686868"
				},
				{
					"slug": "accent-5",
					"name": "Accent 5",
					"color": "#FBFAF3"
				},
				{
					"slug": "accent-6",
					"name": "Accent 6",
					"color": "color-mix(in srgb, currentColor 20%, transparent)"
				}
			],
			"gradients": [
				{
					"slug": "gradient-1",
					"name": "Vertical soft wash to base",
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--accent-5) 0%, var(--wp--preset--color--base) 100%)"
				},
				{
					"slug": "gradient-2",
					"name": "Vertical hard wash to base",
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--accent-5) 90%, var(--wp--preset--color--base) 90%)"
				}
			],
			"duotone": [
				{
					"slug": "duotone-1",
					"name": "Black and white",
					"colors": [ "#000000", "#FFFFFF" ]
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 2px 8px rgba(0, 0, 0, 0.08)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "%", "px", "em", "rem", "vh", "dvh", "vw" ],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tiny",
					"size": "10px"
				},
				{
					"slug": "30",
					"name": "X-Small",
					"size": "20px"
				},
				{
					"slug": "40",
					"name": "Small",
					"size": "30px"
				},
				{
					"slug": "50",
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)"
				},
				{
					"slug": "60",
					"name": "Large",
					"size": "clamp(30px, 7vw, 70px)"
				},
				{
					"slug": "70",
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 90px)"
				},
				{
					"slug": "80",
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 140px)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.38rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Extra Extra Large",
					"size": "2.15rem",
					"fluid": {
						"min": "2.15rem",
						"max": "3rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, sans-serif"
				},
				{
					"slug": "besley",
					"name": "Besley",
					"fontFamily": "\"Besley\", serif"
				},
				{
					"slug": "fira-code",
					"name": "Fira Code",
					"fontFamily": "\"Fira Code\", monospace"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|large",
			"fontWeight": "300",
			"letterSpacing": "-0.1px",
			"lineHeight": "1.4"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "-0.1px",
					"lineHeight": "1.125"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "9999px"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "2.25rem",
						"bottom": "1rem",
						"left": "2.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--contrast) 85%, transparent)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.4"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "1px"
						}
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|fira-code",
					"fontSize": "var:preset|font-size|medium"
				},
				"color": {
					"background": "var:preset|color|accent-5"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/group": {
				"variations": {
					"crop-contents": {
						"css": "overflow:clip;"
					}
				}
			},
			"core/heading": {
				"variations": {
					"text-display": {
						"typography": {
							"fontSize": "clamp(2.2rem, 2.2rem + ((1vw - 0.2rem) * 1.333), 3.5rem)",
							"lineHeight": "1.2"
						}
					},
					"text-subtitle": {
						"typography": {
							"fontSize": "clamp(1.5rem, 1.5rem + ((1vw - 0.2rem) * 0.392), 1.75rem)",
							"lineHeight": "1.2"
						}
					},
					"text-annotation": {
						"css": "width: fit-content",
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"lineHeight": "1.5",
							"letterSpacing": "normal"
						},
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "1px",
							"radius": "16px"
						},
						"spacing": {
							"padding": {
								"top": "0.2rem",
								"right": "0.6rem",
								"bottom": "0.25rem",
								"left": "0.6rem"
							}
						}
					}
				}
			},
			"core/paragraph": {
				"variations": {
					"text-display": {
						"typography": {
							"fontSize": "clamp(2.2rem, 2.2rem + ((1vw - 0.2rem) * 1.333), 3.5rem)",
							"lineHeight": "1.2"
						}
					},
					"text-subtitle": {
						"typography": {
							"fontSize": "clamp(1.5rem, 1.5rem + ((1vw - 0.2rem) * 0.392), 1.75rem)",
							"lineHeight": "1.2"
						}
					},
					"text-annotation": {
						"css": "width: fit-content",
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"lineHeight": "1.5",
							"letterSpacing": "normal"
						},
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "1px",
							"radius": "16px"
						},
						"spacing": {
							"padding": {
								"top": "0.2rem",
								"right": "0.6rem",
								"bottom": "0.25rem",
								"left": "0.6rem"
							}
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|besley",
					"fontSize": "var:preset|font-size|x-large"
				},
				"border": {
					"left": {
						"color": "var:preset|color|accent-3",
						"width": "2px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|30"
					}
				}
			},
			"core/separator": {
				"border": {
					"bottom": {
						"color": "var:preset|color|accent-6",
						"width": "1px",
						"style": "solid"
					}
				}
			}
		}
	}
}
