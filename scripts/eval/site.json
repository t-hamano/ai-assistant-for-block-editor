{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "645px", "wideSize": "1340px" },
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contrast", "color": "#111111" },
				{ "slug": "accent-1", "name": "Accent 1", "color": "#FFEE58" },
				{ "slug": "accent-2", "name": "Accent 2", "color": "#F6CFF4" },
				{ "slug": "accent-3", "name": "Accent 3", "color": "#503AA8" },
				{ "slug": "accent-4", "name": "Accent 4", "color": "#686868" },
				{ "slug": "accent-5", "name": "Accent 5", "color": "#FBFAF3" },
				{
					"slug": "accent-6",
					"name": "Accent 6",
					"color": "color-mix(in srgb, currentColor 20%, transparent)"
				}
			],
			"gradients": [
				{
					"slug": "gradient-1",
					"name": "Vertical soft wash to base",
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--accent-5) 0%, var(--wp--preset--color--base) 100%)"
				},
				{
					"slug": "gradient-2",
					"name": "Vertical hard wash to base",
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--accent-5) 90%, var(--wp--preset--color--base) 90%)"
				}
			],
			"duotone": [
				{ "slug": "duotone-1", "name": "Black and white", "colors": [ "#000000", "#FFFFFF" ] }
			]
		},
		"shadow": {
			"presets": [ { "slug": "soft", "name": "Soft", "shadow": "0 2px 8px rgba(0, 0, 0, 0.08)" } ]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "%", "px", "em", "rem", "vh", "dvh", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "Tiny", "size": "10px" },
				{ "slug": "30", "name": "X-Small", "size": "20px" },
				{ "slug": "40", "name": "Small", "size": "30px" },
				{ "slug": "50", "name": "Regular", "size": "clamp(30px, 5vw, 50px)" },
				{ "slug": "60", "name": "Large", "size": "clamp(30px, 7vw, 70px)" },
				{ "slug": "70", "name": "X-Large", "size": "clamp(50px, 7vw, 90px)" },
				{ "slug": "80", "name": "XX-Large", "size": "clamp(70px, 10vw, 140px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": { "min": "1rem", "max": "1.125rem" }
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.38rem",
					"fluid": { "min": "1.125rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.75rem",
					"fluid": { "min": "1.75rem", "max": "2rem" }
				},
				{
					"slug": "xx-large",
					"name": "Extra Extra Large",
					"size": "2.15rem",
					"fluid": { "min": "2.15rem", "max": "3rem" }
				}
			],
			"fontFamilies": [
				{ "slug": "manrope", "name": "Manrope", "fontFamily": "Manrope, sans-serif" },
				{ "slug": "besley", "name": "Besley", "fontFamily": "\"Besley\", serif" },
				{ "slug": "fira-code", "name": "Fira Code", "fontFamily": "\"Fira Code\", monospace" }
			]
		}
	}
}
